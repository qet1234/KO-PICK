# Vercel / browser-safe public values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Server-only NAVER Search credentials
# Prefer NAVER API HUB for new integrations after 2026-07-31.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
# Legacy NAVER Developers Search API keys remain supported during the migration period.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Supabase Edge Function secrets
# Register with: npx supabase secrets set KEY=value
TOUR_API_SERVICE_KEY=
TOUR_API_MOBILE_APP=KoreaPick
KAKAO_REST_API_KEY=

# Sign in with Apple token revocation for account deletion (Supabase Edge Function only)
# APPLE_PRIVATE_KEY accepts the .p8 contents with literal \n line breaks.
APPLE_CLIENT_ID=com.koreapick.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Supabase automatically injects these into deployed Edge Functions.
# Local function serving can read them from supabase/.env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth provider credentials are entered in Supabase Dashboard > Authentication > Providers.
# Google: built-in provider
# Kakao: built-in provider
# Naver: custom OAuth2 provider identifier `custom:naver`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
